        <mxCell id="fjiv74B2g2Rp5R7PVZmW-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;strokeWidth=2;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;span data-path-to-node=&quot;2,0,2,0,0,0&quot;&gt;&lt;b data-path-to-node=&quot;2,0,2,0,0,0&quot; data-index-in-node=&quot;0&quot;&gt;MVP Tahap 1: Alur Login &amp;amp; Hak Akses (Role)&lt;/b&gt;&amp;nbsp;&lt;/span&gt;&lt;span data-path-to-node=&quot;4,0,2,0,0,0&quot;&gt;Berdasarkan diagram login, sistem memastikan pengguna masuk, memvalidasi data, dan mengarahkan hak akses sesuai rolenya masing-masing (Admin, Kasir, atau Manager)&lt;/span&gt;&lt;span data-path-to-node=&quot;4,0,2,0,0,1&quot;&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span data-path-to-node=&quot;4,0,2,0,0,2&quot;&gt;.&lt;/span&gt;&lt;/font&gt;" vertex="1">
